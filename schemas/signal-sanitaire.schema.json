{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pollutions-cda.fr/schemas/signal-sanitaire.schema.json",
  "title": "Signal sanitaire",
  "description": "Signal épidémiologique. Aucun lien causal avec un site n'est enregistré ni affiché.",
  "type": "object",
  "required": [
    "id",
    "libelle",
    "population",
    "periode",
    "auteur_etude",
    "resultat",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "defs.schema.json#/$defs/slug"
    },
    "libelle": {
      "type": "string"
    },
    "communes": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/code_insee"
      }
    },
    "zone_libelle": {
      "type": "string",
      "description": "Zone de l'étude quand elle ne suit pas les limites communales."
    },
    "geometry": {
      "$ref": "defs.schema.json#/$defs/geometry"
    },
    "population": {
      "type": "string"
    },
    "periode": {
      "$ref": "defs.schema.json#/$defs/periode"
    },
    "auteur_etude": {
      "type": "string"
    },
    "resultat": {
      "type": "string",
      "description": "Ce que l'étude mesure, dans ses termes. Observé contre attendu, intervalle quand il est publié."
    },
    "facteurs_de_risque_connus": {
      "type": "string",
      "description": "Ce que l'étude dit des facteurs de confusion."
    },
    "enquetes_en_cours": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nom",
          "pilote"
        ],
        "additionalProperties": false,
        "properties": {
          "nom": {
            "type": "string"
          },
          "pilote": {
            "type": "string"
          },
          "echeance": {
            "$ref": "defs.schema.json#/$defs/date_floue"
          },
          "source": {
            "$ref": "defs.schema.json#/$defs/slug"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "defs.schema.json#/$defs/slug"
      }
    },
    "niveau_source": {
      "enum": [
        "etude_publiee",
        "presse"
      ],
      "description": "etude_publiee : le chiffre est lu dans l'étude. presse : le chiffre n'est connu que par la presse, qui cite l'étude ou ses auteurs."
    }
  }
}
